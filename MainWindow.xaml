<Window x:Class="AiLaTrieuPhu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ai Là Triệu Phú - TUNG_AU" Height="780" Width="1240"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource StudioBackgroundBrush}">

    <Grid>
        <!-- Background Ambient Glow Elements -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="600" Height="600" Fill="#1E3A8A" Opacity="0.18" Canvas.Left="-150" Canvas.Top="-150">
                <Ellipse.Effect><BlurEffect Radius="160"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="500" Height="500" Fill="#0284C7" Opacity="0.14" Canvas.Right="-100" Canvas.Bottom="-100">
                <Ellipse.Effect><BlurEffect Radius="140"/></Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- Main Layout Container -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Navbar -->
                <RowDefinition Height="*"/>    <!-- Content Screen -->
            </Grid.RowDefinitions>

            <!-- 1. TOP NAVBAR -->
            <Border Grid.Row="0" Background="#0C1527" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="18,10" Margin="0,0,0,16">
                <Grid>
                    <!-- Brand / Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource GoldBrush}" CornerRadius="20" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="★" FontSize="20" FontWeight="Bold" Foreground="#0A1128" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI LÀ TRIỆU PHÚ" FontSize="20" FontWeight="Black" Foreground="{StaticResource GoldBrush}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#FFB703" Opacity="0.6" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="CHINH PHỤC 15 CÂU HỎI ĐỈNH CAO KIẾN THỨC" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Top Menu Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnMute" Click="BtnMute_Click" Margin="0,0,8,0" Style="{StaticResource ModernButtonStyle}" Background="#162032" BorderBrush="#334155" Padding="12,8">
                            <TextBlock x:Name="txtMuteIcon" Text="🔊 Âm thanh: Bật" Foreground="White" FontSize="13"/>
                        </Button>

                        <Button x:Name="btnToggleVoice" Click="BtnToggleVoice_Click" Margin="0,0,8,0" Style="{StaticResource ModernButtonStyle}" Background="#162032" BorderBrush="#334155" Padding="12,8">
                            <TextBlock x:Name="txtVoiceIcon" Text="🎙️ Giọng đọc MC: Bật" Foreground="{StaticResource CyanBrush}" FontSize="13" FontWeight="SemiBold"/>
                        </Button>

                        <Button Click="BtnHowToPlay_Click" Margin="0,0,8,0" Style="{StaticResource ModernButtonStyle}" Background="#162032" BorderBrush="#334155" Padding="12,8">
                            <TextBlock Text="📜 Hướng dẫn" Foreground="White" FontSize="13"/>
                        </Button>

                        <Button Click="BtnHighScores_Click" Margin="0,0,8,0" Style="{StaticResource ModernButtonStyle}" Background="#162032" BorderBrush="#334155" Padding="12,8">
                            <TextBlock Text="🏆 Bảng vàng" Foreground="{StaticResource GoldBrush}" FontSize="13" FontWeight="Bold"/>
                        </Button>

                        <Button Click="BtnQuestionManager_Click" Style="{StaticResource ModernButtonStyle}" Background="#162032" BorderBrush="#334155" Padding="12,8">
                            <TextBlock Text="📚 Quản lý câu hỏi" Foreground="{StaticResource CyanBrush}" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. CONTENT AREA -->
            <Grid Grid.Row="1">
                <!-- SCREEN A: MENU / START SCREEN -->
                <Border x:Name="pnlMenu" Visibility="Visible" Background="#0C1527" CornerRadius="16" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5" Padding="40,30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" Color="#00B4D8" Opacity="0.3" ShadowDepth="0"/>
                    </Border.Effect>

                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="680">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Logo Circle Emblem -->
                            <Grid Width="150" Height="150" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Ellipse Fill="#101D36" Stroke="{StaticResource GoldBrush}" StrokeThickness="4">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="25" Color="#FFB703" Opacity="0.8" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Margin="10" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" StrokeDashArray="3 2"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="150" FontSize="36" FontWeight="Black" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="TRIỆU ĐỒNG" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="CHÀO MỪNG ĐẾN VỚI GHẾ NÓNG" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Hãy trả lời chính xác 15 câu hỏi để chạm tay vào giải thưởng 150 triệu đồng!"
                                       FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,26"/>

                            <!-- Player Input Box -->
                            <Border Background="#131F35" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="👤 Họ và tên người chơi:" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtPlayerName" Text="Nguyễn Văn A" Padding="12,10" Background="#0A1128" Foreground="{StaticResource GoldBrush}" BorderBrush="{StaticResource CyanBrush}" FontSize="16" FontWeight="Bold"/>

                                    <CheckBox x:Name="chkTimerEnabled" IsChecked="True" Content="Bật đồng hồ áp lực thời gian (30s / câu hỏi)"
                                              Foreground="#CBD5E1" FontSize="13" Margin="0,14,0,0" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Feature Badges -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#131F35" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="15 CÂU HỎI" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="3 mốc an toàn 5, 10, 15" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#131F35" CornerRadius="8" Padding="10" Margin="3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="5 TRỢ GIÚP" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Khán giả, 50:50, Gọi điện..." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#131F35" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="150 TRIỆU Đ" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Giải thưởng tối đa" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Start Button -->
                            <Button Content="▶ BẮT ĐẦU CHINH PHỤC" Click="BtnStartGame_Click"
                                    Style="{StaticResource PrimaryGoldButtonStyle}"
                                    Height="52" Width="300" FontSize="18" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SCREEN B: ACTIVE GAME ARENA -->
                <Grid x:Name="pnlGame" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>       <!-- Arena: Questions & Answers -->
                        <ColumnDefinition Width="310"/>     <!-- Right: Prize Ladder -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: QUESTION ARENA -->
                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Lifelines & Header Info -->
                            <RowDefinition Height="Auto"/> <!-- Timer bar -->
                            <RowDefinition Height="*"/>    <!-- Question Frame -->
                            <RowDefinition Height="Auto"/> <!-- 4 Answers Grid -->
                            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Lifelines & Game Stats -->
                        <Border Grid.Row="0" Background="#0C1527" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="16,10" Margin="0,0,0,12">
                            <Grid>
                                <!-- Lifelines Row -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="btnLifeline5050" Click="BtnLifeline5050_Click" Style="{StaticResource LifelineButtonStyle}" ToolTip="Trợ giúp 50:50" Margin="0,0,12,0">
                                        <TextBlock Text="50:50" FontWeight="Black" FontSize="14" Foreground="{StaticResource GoldBrush}"/>
                                    </Button>

                                    <Button x:Name="btnLifelinePhone" Click="BtnLifelinePhone_Click" Style="{StaticResource LifelineButtonStyle}" ToolTip="Gọi điện cho người thân" Margin="0,0,12,0">
                                        <TextBlock Text="📞" FontSize="20"/>
                                    </Button>

                                    <Button x:Name="btnLifelineAudience" Click="BtnLifelineAudience_Click" Style="{StaticResource LifelineButtonStyle}" ToolTip="Hỏi ý kiến khán giả" Margin="0,0,12,0">
                                        <TextBlock Text="👥" FontSize="20"/>
                                    </Button>

                                    <Button x:Name="btnLifelineExperts" Click="BtnLifelineExperts_Click" Style="{StaticResource LifelineButtonStyle}" ToolTip="Hỏi tổ tư vấn tại chỗ" Margin="0,0,12,0">
                                        <TextBlock Text="👨‍🏫" FontSize="20"/>
                                    </Button>

                                    <Button x:Name="btnLifelineSwitch" Click="BtnLifelineSwitch_Click" Style="{StaticResource LifelineButtonStyle}" ToolTip="Đổi câu hỏi khác">
                                        <TextBlock Text="🔄" FontSize="20"/>
                                    </Button>
                                </StackPanel>

                                <!-- Current Level & Prize Badge -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#131F35" CornerRadius="8" Padding="14,6" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="CÂU: " Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="txtCurrentLevelBadge" Text="1 / 15" Foreground="{StaticResource GoldBrush}" FontWeight="Black" FontSize="15"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#131F35" CornerRadius="8" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="TRỊ GIÁ: " Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="txtCurrentPrizeBadge" Text="200.000 đ" Foreground="{StaticResource GreenBrush}" FontWeight="Black" FontSize="15"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 1: Timer Display -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Border Background="#0F172A" CornerRadius="8" Height="28" BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <ProgressBar x:Name="pbTimer" Minimum="0" Maximum="30" Value="30" Height="26"
                                                 Foreground="{StaticResource GreenBrush}" Background="Transparent" BorderThickness="0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⏱ " FontSize="14" Foreground="White"/>
                                        <TextBlock x:Name="txtTimer" Text="30s" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Row 2: Big Studio Question Box -->
                        <Border Grid.Row="2" Background="{StaticResource QuestionBoxBrush}" CornerRadius="16"
                                BorderBrush="{StaticResource CyanBrush}" BorderThickness="2" Padding="28,20" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="#00B4D8" Opacity="0.45" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Category and Level Tag -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtCategory" Text="Lĩnh vực: Địa lý" Foreground="{StaticResource CyanLightBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="txtQuestionMeta" Text="Câu hỏi dành cho giải thưởng khởi động" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Question Text -->
                                <TextBlock Grid.Row="1" x:Name="txtQuestionContent"
                                           Text="Nội dung câu hỏi sẽ hiển thị ở đây..."
                                           Foreground="White" FontSize="21" FontWeight="SemiBold"
                                           TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="32"/>
                            </Grid>
                        </Border>

                        <!-- Row 3: 4 Answer Options (A, B, C, D) -->
                        <Grid Grid.Row="3" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="64"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Answer A -->
                            <Button x:Name="btnAnswerA" Grid.Row="0" Grid.Column="0" Click="BtnAnswer_Click" Tag="0" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource AnswerDefaultBrush}" BorderBrush="{StaticResource CyanBrush}">
                                <Grid HorizontalAlignment="Left" Margin="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="A: " FontWeight="Black" FontSize="18" Foreground="{StaticResource GoldBrush}"/>
                                        <TextBlock x:Name="txtAnswerA" Text="Phương án A" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Answer B -->
                            <Button x:Name="btnAnswerB" Grid.Row="0" Grid.Column="2" Click="BtnAnswer_Click" Tag="1" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource AnswerDefaultBrush}" BorderBrush="{StaticResource CyanBrush}">
                                <Grid HorizontalAlignment="Left" Margin="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B: " FontWeight="Black" FontSize="18" Foreground="{StaticResource GoldBrush}"/>
                                        <TextBlock x:Name="txtAnswerB" Text="Phương án B" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Answer C -->
                            <Button x:Name="btnAnswerC" Grid.Row="2" Grid.Column="0" Click="BtnAnswer_Click" Tag="2" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource AnswerDefaultBrush}" BorderBrush="{StaticResource CyanBrush}">
                                <Grid HorizontalAlignment="Left" Margin="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="C: " FontWeight="Black" FontSize="18" Foreground="{StaticResource GoldBrush}"/>
                                        <TextBlock x:Name="txtAnswerC" Text="Phương án C" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Answer D -->
                            <Button x:Name="btnAnswerD" Grid.Row="2" Grid.Column="2" Click="BtnAnswer_Click" Tag="3" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource AnswerDefaultBrush}" BorderBrush="{StaticResource CyanBrush}">
                                <Grid HorizontalAlignment="Left" Margin="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="D: " FontWeight="Black" FontSize="18" Foreground="{StaticResource GoldBrush}"/>
                                        <TextBlock x:Name="txtAnswerD" Text="Phương án D" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- Row 4: Bottom Action Bar & Walk Away -->
                        <Border Grid.Row="4" Background="#0C1527" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="14,10">
                            <Grid>
                                <!-- Walk Away Button -->
                                <Button x:Name="btnWalkAway" Content="🛑 DỪNG CUỘC CHƠI" Click="BtnWalkAway_Click"
                                        Style="{StaticResource ModernButtonStyle}" Background="#331820" BorderBrush="{StaticResource RedBrush}" Foreground="{StaticResource RedBrush}"
                                        HorizontalAlignment="Left" Padding="18,8" FontWeight="Bold"/>

                                <!-- Status / Explanation Hint -->
                                <TextBlock x:Name="txtStatusMessage" Text="Hãy chọn phương án bạn cho là chính xác..."
                                           Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Next Question Action (Shown after correct answer) -->
                                <Button x:Name="btnNextQuestion" Content="CÂU KẾ TIẾP ▶" Click="BtnNextQuestion_Click"
                                        Style="{StaticResource PrimaryGoldButtonStyle}" Visibility="Collapsed"
                                        HorizontalAlignment="Right" Padding="20,8"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT: PRIZE LADDER -->
                    <Border Grid.Column="1" Background="#0C1527" CornerRadius="16" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="THANG TIỀN THƯỞNG" FontWeight="Black" FontSize="16" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                            <!-- Prize list (Descending 15 to 1) -->
                            <ItemsControl Grid.Row="1" x:Name="icPrizeLadder">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="itemBorder" CornerRadius="6" Margin="0,2" Padding="10,4"
                                                BorderThickness="1" BorderBrush="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Level, StringFormat='{}{0:D2}'}" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountFormatted}" FontWeight="Bold" FontSize="14" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="★" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsMilestone, Converter={x:Null}}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Milestone triggers -->
                                            <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#17223D"/>
                                            </DataTrigger>
                                            <!-- Current level active trigger -->
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource GoldBrush}"/>
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#FFF3B0"/>
                                            </DataTrigger>
                                            <!-- Passed level trigger -->
                                            <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                <Setter TargetName="itemBorder" Property="Opacity" Value="0.6"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- OVERLAY: GAME OVER / VICTORY / MILESTONE MODAL -->
                <Border x:Name="pnlOverlayModal" Visibility="Collapsed" Background="#D8070B19" CornerRadius="16">
                    <Border Background="#0F1D36" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="18" Padding="36,30" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" Color="#FFB703" Opacity="0.7" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Icon / Trophy -->
                            <TextBlock x:Name="txtModalIcon" Text="🏆" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            
                            <!-- Modal Title -->
                            <TextBlock x:Name="txtModalTitle" Text="BẠN ĐÃ TRỞ THÀNH TRIỆU PHÚ!"
                                       FontSize="22" FontWeight="Black" Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Modal Subtitle -->
                            <TextBlock x:Name="txtModalSubtitle" Text="Xin chúc mừng bạn đã xuất sắc vượt qua toàn bộ 15 câu hỏi!"
                                       FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <!-- Final Prize Box -->
                            <Border Background="#0A1128" CornerRadius="10" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1.5" Padding="20,12" Margin="0,0,0,24">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="TIỀN THƯỞNG BẠN NHẬN ĐƯỢC:" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtModalPrize" Text="150.000.000 đ" FontSize="28" FontWeight="Black" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Modal Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="CHƠI LẠI" Click="BtnPlayAgain_Click" Style="{StaticResource PrimaryGoldButtonStyle}" Width="150" Height="42" Margin="0,0,12,0"/>
                                <Button Content="VỀ TRANG CHỦ" Click="BtnBackToMenu_Click" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" BorderBrush="#334155" Width="150" Height="42"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>