<Window x:Class="AiLaTrieuPhu.Views.AudienceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ý kiến Khán giả Trường quay" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource StudioBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="14" Background="{StaticResource StudioBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#00B4D8" Opacity="0.6" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="👥 Ý KIẾN KHÁN GIẢ TRƯỜNG QUAY"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Kết quả khảo sát trực tiếp từ 100 khán giả"
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bar Chart Area -->
            <Grid Grid.Row="1" Margin="20,10,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column A -->
                <Grid Grid.Column="0" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtPercentA" Grid.Row="0" Text="0%" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="6,6,0,0" Background="{StaticResource CyanGradientBrush}" x:Name="barA" Height="50">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#00B4D8" Opacity="0.5" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Grid.Row="2" Text="A" FontWeight="Bold" FontSize="20" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </Grid>

                <!-- Column B -->
                <Grid Grid.Column="1" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtPercentB" Grid.Row="0" Text="0%" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="6,6,0,0" Background="{StaticResource CyanGradientBrush}" x:Name="barB" Height="50">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#00B4D8" Opacity="0.5" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Grid.Row="2" Text="B" FontWeight="Bold" FontSize="20" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </Grid>

                <!-- Column C -->
                <Grid Grid.Column="2" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtPercentC" Grid.Row="0" Text="0%" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="6,6,0,0" Background="{StaticResource CyanGradientBrush}" x:Name="barC" Height="50">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#00B4D8" Opacity="0.5" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Grid.Row="2" Text="C" FontWeight="Bold" FontSize="20" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </Grid>

                <!-- Column D -->
                <Grid Grid.Column="3" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtPercentD" Grid.Row="0" Text="0%" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="6,6,0,0" Background="{StaticResource CyanGradientBrush}" x:Name="barD" Height="50">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#00B4D8" Opacity="0.5" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Grid.Row="2" Text="D" FontWeight="Bold" FontSize="20" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </Grid>
            </Grid>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="CẢM ƠN KHÁN GIẢ" Click="BtnClose_Click"
                    Style="{StaticResource PrimaryGoldButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" Width="200" Height="42" />
        </Grid>
    </Border>
</Window>