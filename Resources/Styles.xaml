<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <Color x:Key="ColorDarkBg">#070B19</Color>
    <Color x:Key="ColorNavy1">#0D1B2A</Color>
    <Color x:Key="ColorNavy2">#1B263B</Color>
    <Color x:Key="ColorNavy3">#415A77</Color>
    <Color x:Key="ColorGold">#FFB703</Color>
    <Color x:Key="ColorGoldLight">#FFE066</Color>
    <Color x:Key="ColorGoldDark">#FB8500</Color>
    <Color x:Key="ColorCyan">#00B4D8</Color>
    <Color x:Key="ColorCyanLight">#90E0EF</Color>
    <Color x:Key="ColorGreen">#06D6A0</Color>
    <Color x:Key="ColorRed">#EF476F</Color>
    <Color x:Key="ColorOrange">#F77F00</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource ColorDarkBg}" />
    <SolidColorBrush x:Key="Navy1Brush" Color="{StaticResource ColorNavy1}" />
    <SolidColorBrush x:Key="Navy2Brush" Color="{StaticResource ColorNavy2}" />
    <SolidColorBrush x:Key="Navy3Brush" Color="{StaticResource ColorNavy3}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource ColorGold}" />
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource ColorGoldLight}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="CyanLightBrush" Color="{StaticResource ColorCyanLight}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource ColorRed}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource ColorOrange}" />

    <!-- Gradient Brushes -->
    <RadialGradientBrush x:Key="StudioBackgroundBrush" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#1A2D4A" Offset="0.0" />
        <GradientStop Color="#0D1B2A" Offset="0.55" />
        <GradientStop Color="#060A14" Offset="1.0" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="QuestionBoxBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A2849" Offset="0.0" />
        <GradientStop Color="#0D1B2E" Offset="0.5" />
        <GradientStop Color="#14213D" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE066" Offset="0.0" />
        <GradientStop Color="#FFB703" Offset="0.5" />
        <GradientStop Color="#D48B00" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#90E0EF" Offset="0.0" />
        <GradientStop Color="#00B4D8" Offset="0.5" />
        <GradientStop Color="#0077B6" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6EE7B7" Offset="0.0" />
        <GradientStop Color="#10B981" Offset="0.5" />
        <GradientStop Color="#047857" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCA5A5" Offset="0.0" />
        <GradientStop Color="#EF4444" Offset="0.5" />
        <GradientStop Color="#B91C1C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AnswerDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E293B" Offset="0.0" />
        <GradientStop Color="#0F172A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Button Styles -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryGoldButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GoldGradientBrush}" />
        <Setter Property="BorderBrush" Value="#FFF3B0" />
        <Setter Property="Foreground" Value="#0A1128" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="LifelineButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="bgCircle"
                                 Fill="#162238"
                                 Stroke="{StaticResource CyanBrush}"
                                 StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#00B4D8" Opacity="0.5" ShadowDepth="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Line x:Name="strikeLine" X1="8" Y1="8" X2="48" Y2="48" Stroke="#EF4444" StrokeThickness="3.5" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bgCircle" Property="Stroke" Value="{StaticResource GoldBrush}" />
                            <Setter TargetName="bgCircle" Property="Fill" Value="#1E2F4C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bgCircle" Property="Opacity" Value="0.4" />
                            <Setter TargetName="bgCircle" Property="Stroke" Value="#64748B" />
                            <Setter TargetName="strikeLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>