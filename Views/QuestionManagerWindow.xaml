<Window x:Class="AiLaTrieuPhu.Views.QuestionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Ngân Hàng Câu Hỏi" Height="680" Width="920"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource StudioBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="14" Background="{StaticResource StudioBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="📚 QUẢN LÝ NGÂN HÀNG CÂU HỎI" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                    <TextBlock x:Name="txtTotalCount" Text="(Tổng cộng: 60 câu)" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Cursor="Hand" Padding="8,4"/>
            </Grid>

            <!-- Search and Filter bar -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Margin="0,0,10,0" Padding="10,8" Background="#1E293B" Foreground="White" BorderBrush="#334155" FontSize="13" TextChanged="TxtSearch_TextChanged"/>

                <ComboBox x:Name="cbLevelFilter" Grid.Column="1" Margin="0,0,10,0" Padding="10,8" Background="#1E293B" Foreground="White" SelectionChanged="CbLevelFilter_SelectionChanged"/>

                <Button Grid.Column="2" Content="+ Thêm câu hỏi" Click="BtnAddQuestion_Click"
                        Style="{StaticResource ModernButtonStyle}" Background="{StaticResource GreenGradientBrush}" BorderBrush="#6EE7B7" Padding="14,8"/>
            </Grid>

            <!-- DataGrid list -->
            <DataGrid Grid.Row="2" x:Name="dgQuestions" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="1" BorderBrush="#1E293B"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B"
                      RowBackground="#0D1B2A" AlternatingRowBackground="#132338"
                      Foreground="White" FontSize="13" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1B263B"/>
                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                    <DataGridTextColumn Header="Cấp" Binding="{Binding Level}" Width="45">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Lĩnh vực" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Nội dung câu hỏi" Binding="{Binding Content}" Width="*"/>
                    <DataGridTemplateColumn Header="Đáp án đúng" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CorrectIndex, Converter={x:Null}}" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xóa" Click="BtnDelete_Click" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="8,2" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom Add Panel (Collapsible) -->
            <Border Grid.Row="3" x:Name="pnlAddForm" Visibility="Collapsed" Background="#162238" CornerRadius="10" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="➕ THÊM CÂU HỎI MỚI VÀO NGÂN HÀNG" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" FontSize="15" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nội dung câu hỏi:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtNewContent" Grid.Column="1" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,16,0"/>

                        <TextBlock Text="Cấp độ (1-15):" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cbNewLevel" Grid.Column="3" Background="#0F172A" Foreground="White"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Phương án A:" Foreground="#FFB703" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtOptA" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                            <TextBlock Text="Phương án C:" Foreground="#FFB703" Margin="0,6,0,2"/>
                            <TextBox x:Name="txtOptC" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Phương án B:" Foreground="#FFB703" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtOptB" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                            <TextBlock Text="Phương án D:" Foreground="#FFB703" Margin="0,6,0,2"/>
                            <TextBox x:Name="txtOptD" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Đáp án đúng:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cbNewCorrect" Grid.Column="1" Margin="0,0,16,0">
                            <ComboBoxItem Content="A" IsSelected="True"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="D"/>
                        </ComboBox>

                        <TextBlock Text="Lĩnh vực:" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtNewCategory" Grid.Column="3" Text="Tổng hợp" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="LƯU CÂU HỎI" Click="BtnSaveNewQuestion_Click" Style="{StaticResource PrimaryGoldButtonStyle}" Height="34" Width="120" Margin="0,0,8,0"/>
                            <Button Content="HỦY" Click="BtnCancelAdd_Click" Style="{StaticResource ModernButtonStyle}" Background="#334155" BorderBrush="#475569" Height="34" Width="70"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>