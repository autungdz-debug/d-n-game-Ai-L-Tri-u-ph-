<Window x:Class="AiLaTrieuPhu.Views.ExpertsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ý kiến Tổ tư vấn tại chỗ" Height="500" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource StudioBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="16" Background="{StaticResource StudioBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#00B4D8" Opacity="0.6" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="👨‍🏫 Ý KIẾN TỔ TƯ VẤN TẠI CHỖ"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="3 vị khán giả / chuyên gia trực tiếp trợ giúp bạn"
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3 Experts Cards -->
            <ItemsControl Grid.Row="1" x:Name="icExperts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6" Background="#131F35" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="👤" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExpertName}" FontWeight="Bold" Foreground="White" FontSize="15"/>
                                    <TextBlock Text="{Binding Expertise}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding Reasoning}" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{StaticResource GoldBrush}" CornerRadius="8" Width="44" Height="44" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SuggestedAnswer}" FontWeight="Bold" FontSize="22" Foreground="#0A1128" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="CẢM ƠN TỔ TƯ VẤN" Click="BtnClose_Click"
                    Style="{StaticResource PrimaryGoldButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Width="200" Height="40" />
        </Grid>
    </Border>
</Window>