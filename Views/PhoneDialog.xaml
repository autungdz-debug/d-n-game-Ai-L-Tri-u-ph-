<Window x:Class="AiLaTrieuPhu.Views.PhoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gọi điện cho người thân" Height="530" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource StudioBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="16" Background="{StaticResource StudioBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#00B4D8" Opacity="0.6" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="📞 GỌI ĐIỆN CHO NGƯỜI THÂN"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Bạn có 30 giây để trao đổi cùng người thân"
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Selection Screen or Calling Screen -->
            <Grid Grid.Row="1">
                <!-- Contact Selection List -->
                <StackPanel x:Name="pnlSelectContact" VerticalAlignment="Center">
                    <TextBlock Text="Chọn người thân bạn muốn kết nối máy:" Foreground="White" FontSize="14" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    
                    <Button Click="Contact_Click" Tag="1" Margin="0,4" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" BorderBrush="#334155" HorizontalContentAlignment="Left" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👨‍⚕️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Bác sĩ Lê Hoàng Long" FontWeight="Bold" Foreground="White" FontSize="15"/>
                                <TextBlock Text="Bác sĩ đa khoa, am hiểu sinh học &amp; đời sống" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Click="Contact_Click" Tag="2" Margin="0,4" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" BorderBrush="#334155" HorizontalContentAlignment="Left" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👨‍🏫" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="GS. Trần Văn Khoa" FontWeight="Bold" Foreground="White" FontSize="15"/>
                                <TextBlock Text="Giảng viên Đại học, chuyên sâu lịch sử &amp; địa lý" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Click="Contact_Click" Tag="3" Margin="0,4" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" BorderBrush="#334155" HorizontalContentAlignment="Left" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👩‍💻" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Kỹ sư Phạm Thu Hằng" FontWeight="Bold" Foreground="White" FontSize="15"/>
                                <TextBlock Text="Kỹ sư phần mềm, am hiểu khoa học tự nhiên" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Click="Contact_Click" Tag="4" Margin="0,4" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" BorderBrush="#334155" HorizontalContentAlignment="Left" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🙋‍♂️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Minh Tuấn (Bạn thân)" FontWeight="Bold" Foreground="White" FontSize="15"/>
                                <TextBlock Text="Hiểu biết thể thao, văn hóa đại chúng và điện ảnh" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- In-Call Screen -->
                <StackPanel x:Name="pnlInCall" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border CornerRadius="12" Background="#162032" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock x:Name="txtCallingName" Text="GS. Trần Văn Khoa" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" FontSize="18"/>
                                <TextBlock Text=" (Đang kết nối...)" Foreground="{StaticResource GreenBrush}" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <!-- Dialogue bubble -->
                            <Border CornerRadius="8" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,6,0,12">
                                <TextBlock x:Name="txtDialogue" Text="Lời tư vấn đang được truyền tải..."
                                           TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="15" LineHeight="22"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                                <TextBlock Text="Phương án gợi ý: " Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtSuggested" Text="A" Foreground="{StaticResource GoldBrush}" FontSize="20" FontWeight="Bold" Margin="4,0,12,0"/>
                                <TextBlock Text="Độ tin cậy: " Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtConfidence" Text="90%" Foreground="{StaticResource GreenBrush}" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Bottom action -->
            <Button Grid.Row="2" x:Name="btnClose" Content="ĐÓNG" Click="BtnClose_Click"
                    Style="{StaticResource PrimaryGoldButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Width="180" Height="40" />
        </Grid>
    </Border>
</Window>