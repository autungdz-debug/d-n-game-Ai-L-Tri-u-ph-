<Window x:Class="AiLaTrieuPhu.Views.HowToPlayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luật Chơi Ai Là Triệu Phú" Height="580" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource StudioBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="16" Background="{StaticResource StudioBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#00B4D8" Opacity="0.5" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="📜 LUẬT CHƠI VÀ QUY ĐỊNH"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Cẩm nang hành trình chinh phục 150 triệu đồng"
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Content ScrollViewer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <!-- Section 1 -->
                    <Border Background="#131F35" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🎯 THANG CÂU HỎI VÀ MỐC QUAN TRỌNG" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" FontSize="15" Margin="0,0,0,6"/>
                            <TextBlock Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                                • Người chơi phải vượt qua 15 câu hỏi trắc nghiệm với 4 phương án A, B, C, D (chỉ 1 phương án đúng).&#x0a;
                                • Mốc số 5 (2.000.000 đ) và Mốc số 10 (22.000.000 đ) là hai mốc bảo toàn giải thưởng: Khi vượt qua mốc này, người chơi chắc chắn nhận được số tiền mốc dù trả lời sai ở các câu sau.&#x0a;
                                • Vượt qua Câu 15: Trở thành Triệu Phú với giải thưởng cao nhất 150.000.000 đ!
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Section 2 -->
                    <Border Background="#131F35" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="✨ 5 QUYỀN TRỢ GIÚP ĐẶC BIỆT" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="15" Margin="0,0,0,6"/>
                            <TextBlock Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                                • 50:50: Máy tính tự động loại bỏ ngẫu nhiên 2 phương án sai.&#x0a;
                                • 📞 Gọi điện thoại cho người thân: Kết nối với 1 trong 4 người thân để xin ý kiến tư vấn trong 30s.&#x0a;
                                • 👥 Hỏi ý kiến khán giả: 100 khán giả trường quay bình chọn và hiển thị biểu đồ phần trăm.&#x0a;
                                • 👨‍🏫 Hỏi tổ tư vấn tại chỗ: Nhận phân tích chi tiết từ 3 vị chuyên gia uy tín.&#x0a;
                                • 🔄 Đổi câu hỏi: Đổi sang một câu hỏi hoàn toàn mới cùng cấp độ.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Section 3 -->
                    <Border Background="#131F35" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🛑 DỪNG CUỘC CHƠI (WALK AWAY)" FontWeight="Bold" Foreground="{StaticResource OrangeBrush}" FontSize="15" Margin="0,0,0,6"/>
                            <TextBlock Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                                Trước khi chọn chốt đáp án, bạn có quyền bấm 'Dừng cuộc chơi' để bảo toàn trọn vẹn số tiền thưởng của câu hỏi đã vượt qua gần nhất.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="TÔI ĐÃ HIỂU LUẬT" Click="BtnClose_Click"
                    Style="{StaticResource PrimaryGoldButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Width="180" Height="40" />
        </Grid>
    </Border>
</Window>